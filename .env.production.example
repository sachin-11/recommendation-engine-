# Production settings for docker-compose.prod.yml. Copy to .env.production on the server:
#   cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production.

# ------------------------------------------------------------------ Application
APP_ENV=production
LOG_LEVEL=INFO
# Uvicorn worker processes per container (roughly 2 x CPU cores).
WEB_CONCURRENCY=2
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later invalidates every API key.
SECRET_KEY=
# Browser origins allowed to call the API (your dashboard domain). No "*".
ALLOWED_ORIGINS=https://recoengine.example.com
# Operator key for /api/v1/tenants/* (header X-Admin-Key), 32+ characters. Empty = disabled.
ADMIN_API_KEY=

# ------------------------------------------------------------------ Email (required)
# Verification and password-reset emails. EMAIL_BACKEND=ses uses Amazon SES with the AWS_*
# credentials (the IAM user needs ses:SendRawEmail; request SES production access so any
# address can receive mail). Or EMAIL_BACKEND=smtp with any provider, e.g. Resend
# (smtp.resend.com, user "resend", password = API key), SendGrid or Postmark.
DASHBOARD_URL=https://recoengine.example.com
EMAIL_BACKEND=smtp
EMAIL_FROM=RecoEngine <no-reply@recoengine.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
REQUIRE_EMAIL_VERIFICATION=true

# ------------------------------------------------------------------ Images
# Set by scripts/deploy.sh and the GitHub deploy workflow.
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
AWS_REGION=us-east-1

# ------------------------------------------------------------------ PostgreSQL
# Bundled postgres container (default). For RDS, point DATABASE_URL at the RDS endpoint
# and stop the postgres/postgres-backup services.
POSTGRES_USER=reco
POSTGRES_PASSWORD=
POSTGRES_DB=recommendation_engine
DATABASE_URL=postgresql+asyncpg://reco:<POSTGRES_PASSWORD>@postgres:5432/recommendation_engine
# RDS example:
# DATABASE_URL=postgresql+asyncpg://reco:<password>@recoengine.abc123.us-east-1.rds.amazonaws.com:5432/recommendation_engine
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------ Redis
REDIS_URL=redis://redis:6379/0
# ElastiCache example:
# REDIS_URL=redis://recoengine.abc123.0001.use1.cache.amazonaws.com:6379/0

# ------------------------------------------------------------------ OpenAI and Pinecone
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# USD per 1M embedding tokens, for the cost estimate at /analytics/tokens.
EMBEDDING_PRICE_PER_MILLION_TOKENS=0.02
PINECONE_API_KEY=
# One shared serverless index, one namespace per tenant. Keep the API in the same AWS
# region as the index for low latency.
PINECONE_INDEX_NAME=reco-shared
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# ------------------------------------------------------------------ Limits
MAX_ITEMS_PER_REQUEST=1000
MAX_SYNC_ITEMS=50
MAX_CSV_ITEMS=10000
# Score label bounds for Excellent, Good, Fair (lower is Weak), tuned for
# text-embedding-3-small. Raise them for longer queries or larger models.
SCORE_LABEL_THRESHOLDS=0.65,0.50,0.35
RATE_LIMIT_RPM=100
DAILY_ITEM_LIMIT=10000

# ------------------------------------------------------------------ Monitoring
# Optional error tracking; leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
WORKER_METRICS_PORT=9100
# Grafana is published on 127.0.0.1:3001 only; open it through an SSH tunnel.
GRAFANA_ADMIN_PASSWORD=

# ------------------------------------------------------------------ Dashboard build
# Baked into the dashboard image at build time. Empty = same origin as the dashboard.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DOCS_URL=https://docs.recoengine.example.com

# ------------------------------------------------------------------ LangSmith (optional)
# Traces recommendations, embeddings and vector searches. The LANGCHAIN_* spellings
# (LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, LANGCHAIN_PROJECT) work too.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recoengine
# true = send only timings and counts, not query or item text.
LANGSMITH_HIDE_INPUTS=false
