# Production settings for docker-compose.prod.yml. Copy to .env.production on the server:
#   cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production.

# ------------------------------------------------------------------ Application
APP_ENV=production
LOG_LEVEL=INFO
# Uvicorn worker processes per container (roughly 2 x CPU cores).
WEB_CONCURRENCY=2
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later invalidates every API key.
SECRET_KEY=
# Browser origins allowed to call the API (your dashboard domain). No "*".
ALLOWED_ORIGINS=https://recoengine.example.com

# ------------------------------------------------------------------ Images
# Set by scripts/deploy.sh and the GitHub deploy workflow.
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
AWS_REGION=us-east-1

# ------------------------------------------------------------------ PostgreSQL
# Bundled postgres container (default). For RDS, point DATABASE_URL at the RDS endpoint
# and stop the postgres/postgres-backup services.
POSTGRES_USER=reco
POSTGRES_PASSWORD=
POSTGRES_DB=recommendation_engine
DATABASE_URL=postgresql+asyncpg://reco:<POSTGRES_PASSWORD>@postgres:5432/recommendation_engine
# RDS example:
# DATABASE_URL=postgresql+asyncpg://reco:<password>@recoengine.abc123.us-east-1.rds.amazonaws.com:5432/recommendation_engine
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------ Redis
REDIS_URL=redis://redis:6379/0
# ElastiCache example:
# REDIS_URL=redis://recoengine.abc123.0001.use1.cache.amazonaws.com:6379/0

# ------------------------------------------------------------------ OpenAI and Pinecone
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PINECONE_API_KEY=
# Keep the API in the same AWS region as the Pinecone indexes for low latency.
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# ------------------------------------------------------------------ Limits
MAX_ITEMS_PER_REQUEST=1000
MAX_SYNC_ITEMS=50
MAX_CSV_ITEMS=10000
RATE_LIMIT_RPM=100
DAILY_ITEM_LIMIT=10000

# ------------------------------------------------------------------ Monitoring
# Optional error tracking; leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
WORKER_METRICS_PORT=9100
# Grafana is published on 127.0.0.1:3001 only; open it through an SSH tunnel.
GRAFANA_ADMIN_PASSWORD=

# ------------------------------------------------------------------ Dashboard build
# Baked into the dashboard image at build time. Empty = same origin as the dashboard.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DOCS_URL=https://docs.recoengine.example.com
