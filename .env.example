# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env. Values containing "change-me" are rejected when APP_ENV=production.

# ------------------------------------------------------------------ Application
# development | test | production. Production disables /docs and enforces the
# production checks in app/core/config.py.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------ PostgreSQL
# Used by the postgres container in docker-compose.
POSTGRES_USER=reco
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=recommendation_engine
# Host port Postgres is published on (change if 5432 is already taken).
POSTGRES_PORT=5432

# Async SQLAlchemy URL. The asyncpg driver is required.
# This value is for running the app on your host; docker-compose overrides the
# host to "postgres" automatically.
DATABASE_URL=postgresql+asyncpg://reco:change-me-postgres-password@localhost:5432/recommendation_engine
# Connection pool sizing (per app process).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Log every SQL statement (noisy; development only).
DB_ECHO=false

# ------------------------------------------------------------------ Redis
# Caching and rate limiting. docker-compose overrides the host to "redis".
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------ OpenAI
# Creates the embeddings. Required when APP_ENV=production. Leave empty to run
# without it: uploads are stored as PENDING and embedded once a key is set.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model (text-embedding-3-small: up to 1536). Changing it needs a new index.
EMBEDDING_DIMENSION=1536
# USD per 1M embedding tokens, for the cost estimate at /analytics/tokens.
EMBEDDING_PRICE_PER_MILLION_TOKENS=0.02

# ------------------------------------------------------------------ Pinecone
# Vector storage: one shared serverless index, one namespace per tenant.
# Required when APP_ENV=production.
PINECONE_API_KEY=
# Serverless region and cloud for new indexes.
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws
# Name of the shared index (created on first use).
PINECONE_INDEX_NAME=reco-shared

# ------------------------------------------------------------------ Ingestion limits
MAX_ITEMS_PER_REQUEST=1000
# Largest upload processed synchronously (async=false).
MAX_SYNC_ITEMS=50
MAX_CSV_ITEMS=10000

# ------------------------------------------------------------------ Rate limiting
# Requests per minute per API key.
RATE_LIMIT_RPM=100

# ------------------------------------------------------------------ Recommendations
# Score label bounds for Excellent, Good, Fair (lower is Weak), tuned for
# text-embedding-3-small. Raise them for longer queries or larger models.
SCORE_LABEL_THRESHOLDS=0.65,0.50,0.35
# Items per tenant per UTC day, across JSON and CSV uploads.
DAILY_ITEM_LIMIT=10000

# ------------------------------------------------------------------ Security
# Secret used to HMAC-SHA256 hash API keys before storing them. At least 32 chars.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: changing it invalidates every existing API key.
SECRET_KEY=change-me-generate-a-long-random-secret-key-before-use

# Comma-separated list of browser origins allowed by CORS. Leave empty to disable CORS.
# "*" is rejected in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Operator key for the /api/v1/tenants/* admin routes (header X-Admin-Key), at least
# 32 characters. Leave empty to disable those routes; tenants never need it.
ADMIN_API_KEY=

# ------------------------------------------------------------------ Accounts and email
# Verification and password-reset links point here.
DASHBOARD_URL=http://localhost:3000
# Unverified accounts cannot create API keys and ingest at most this many items a day.
REQUIRE_EMAIL_VERIFICATION=true
UNVERIFIED_DAILY_ITEM_LIMIT=100
# docker compose sends email to Mailpit (inbox at http://localhost:8025) unless you set
# EMAIL_BACKEND here; outside Docker, "console" just logs each email with its link.
# "ses" sends through Amazon SES with AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# (EMAIL_FROM must be a verified SES identity; in the SES sandbox only verified addresses
# receive mail).
EMAIL_BACKEND=console
EMAIL_FROM=RecoEngine <no-reply@recoengine.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) or none
SMTP_SECURITY=starttls

# ------------------------------------------------------------------ Docker
# Host port the API is published on.
APP_PORT=8000

# ------------------------------------------------------------------ LangSmith (optional)
# Traces recommendations, embeddings and vector searches. The LANGCHAIN_* spellings
# (LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, LANGCHAIN_PROJECT) work too.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recoengine
# true = send only timings and counts, not query or item text.
LANGSMITH_HIDE_INPUTS=false
