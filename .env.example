# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env. Values containing "change-me" are rejected when APP_ENV=production.

# ------------------------------------------------------------------ Application
# development | test | production. Production disables /docs and enforces the
# production checks in app/core/config.py.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------ PostgreSQL
# Used by the postgres container in docker-compose.
POSTGRES_USER=reco
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=recommendation_engine
# Host port Postgres is published on (change if 5432 is already taken).
POSTGRES_PORT=5432

# Async SQLAlchemy URL. The asyncpg driver is required.
# This value is for running the app on your host; docker-compose overrides the
# host to "postgres" automatically.
DATABASE_URL=postgresql+asyncpg://reco:change-me-postgres-password@localhost:5432/recommendation_engine
# Connection pool sizing (per app process).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Log every SQL statement (noisy; development only).
DB_ECHO=false

# ------------------------------------------------------------------ Redis
# Caching and rate limiting. docker-compose overrides the host to "redis".
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------ OpenAI
# Used to create embeddings (from Module 2). Required when APP_ENV=production.
OPENAI_API_KEY=sk-change-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------ Pinecone
# Vector storage (from Module 2). Required when APP_ENV=production.
PINECONE_API_KEY=change-me-pinecone-api-key
# Only needed for legacy pod-based indexes (e.g. us-east-1-aws). Serverless indexes ignore it.
PINECONE_ENVIRONMENT=us-east-1-aws

# ------------------------------------------------------------------ Security
# Secret used to HMAC-SHA256 hash API keys before storing them. At least 32 chars.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: changing it invalidates every existing API key.
SECRET_KEY=change-me-generate-a-long-random-secret-key-before-use

# Comma-separated list of browser origins allowed by CORS. Leave empty to disable CORS.
# "*" is rejected in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------ Docker
# Host port the API is published on.
APP_PORT=8000
