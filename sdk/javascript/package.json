{
  "name": "@recoengine/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript client for the RecoEngine recommendation API",
  "license": "MIT",
  "author": "RecoEngine",
  "homepage": "https://docs.recoengine.io/docs/sdks/javascript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachin-11/recommendation-engine-.git",
    "directory": "sdk/javascript"
  },
  "keywords": ["recommendations", "recommendation-engine", "embeddings", "vector-search", "sdk"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
